{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webs1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0b1916dd-9a05-4a44-a88a-d154c4e4f5c2","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "17c35e20d9c144058944760408b8c09e" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
